{
  "name": "cldr-engine-website",
  "private": true,
  "author": "Patrick Hensley <pathensley@gmail.com>",
  "license": "Apache-2.0",
  "version": "1.5.1",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true})\"",
    "generate": "ts-node src/docgen/index.ts",
    "materialize": "node scripts/materialize-versions.js",
    "inventory": "node scripts/url-inventory.js",
    "prebuild": "node gencrossref.js",
    "build": "docusaurus build && node scripts/html-aliases.js",
    "start": "docusaurus start",
    "serve": "docusaurus serve",
    "swizzle": "docusaurus swizzle",
    "check:sidebars": "node scripts/check-sidebars.js",
    "packs": "node scripts/copy-packs.js",
    "build:liveapi": "echo 'Phase 9: liveapi build not yet restored'",
    "check:build": "node scripts/check-build.js",
    "check:content": "node scripts/content-check.js",
    "check:all": "pnpm check:build && pnpm check:content"
  },
  "dependencies": {
    "@mdx-js/react": "^3.0.0",
    "@phensley/cldr": "1.12.1",
    "mdast-util-from-markdown": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@types/node": "^20.0.0",
    "js-yaml": "^4.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.0",
    "@docusaurus/plugin-content-docs": "^3.10.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}